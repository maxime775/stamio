# Public Expo app variables
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Supabase Edge Functions secrets only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
HMAC_SECRET=replace-with-strong-random-secret

# Keep these values in production. Never configure local_test against production data.
APP_ENV=production
OTP_PROVIDER=twilio

# Configure these only in a local Supabase instance or a separate staging project.
OTP_TEST_PHONE_ALLOWLIST=replace-with-local-or-staging-test-phone-list
OTP_TEST_CODE=replace-with-six-digit-test-code
