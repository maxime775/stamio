# Public Expo app variables
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Supabase Edge Functions secrets only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
IP_HASH_SECRET=replace-with-a-dedicated-random-server-secret
VOTER_HASH_SECRET=replace-with-a-distinct-random-server-secret
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
HMAC_SECRET=replace-with-strong-random-secret

# Keep these values in production. Never configure local_test against production data.
APP_ENV=production

# Configure these only in a local Supabase instance or a separate staging project.
